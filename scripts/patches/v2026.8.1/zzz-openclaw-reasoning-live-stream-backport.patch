--- /dev/null
+++ b/packages/ai/src/transports/openai-completions-stream.reasoning-first-live-text.test.ts
@@ -0,0 +1,180 @@
+import { describe, expect, it } from "vitest";
+import { processCompletionsStream } from "./openai-completions-stream.js";
+import {
+  createAssistantOutput,
+  makeCompletionsChunk,
+  makeCompletionsModel,
+} from "./openai-completions.test-support.js";
+
+describe("reasoning-first completions", () => {
+  it.each(["reasoning", "reasoning_content"] as const)(
+    "streams visible text after %s before reading another chunk",
+    async (field) => {
+      const model = makeCompletionsModel();
+      for (const sameChunk of [false, true]) {
+        for (const emitReasoning of [false, true]) {
+          const output = createAssistantOutput(model);
+          const text: string[] = [];
+          async function* chunks() {
+            yield makeCompletionsChunk({ [field]: "Think." });
+            yield makeCompletionsChunk({
+              ...(sameChunk ? { [field]: " Done." } : {}),
+              content: "Answer",
+            });
+            expect(text.join("")).toBe("Answer");
+            yield makeCompletionsChunk({ content: " continues." });
+            expect(text.join("")).toBe("Answer continues.");
+            yield makeCompletionsChunk({ [field]: "Reconsider." });
+            yield makeCompletionsChunk({ content: "Final." });
+            expect(text.join("")).toBe("Answer continues.Final.");
+            yield makeCompletionsChunk({}, "stop");
+          }
+          await processCompletionsStream(
+            chunks(),
+            output,
+            model,
+            {
+              push(event) {
+                if (event.type === "text_delta") {
+                  text.push(event.delta);
+                }
+              },
+            },
+            { emitReasoning },
+          );
+          expect(output.stopReason).toBe("stop");
+          expect(output.content.filter((block) => block.type === "text")).toMatchObject([
+            { text: "Answer continues.", textSignature: expect.stringContaining('"commentary"') },
+            { text: "Final.", textSignature: expect.stringContaining('"final_answer"') },
+          ]);
+        }
+      }
+    },
+  );
+
+  it.each(["", "Answer. "])("keeps unfinished reasoning private after %j", async (prefix) => {
+    const model = makeCompletionsModel();
+    const output = createAssistantOutput(model);
+    const text: string[] = [];
+    async function* chunks() {
+      yield makeCompletionsChunk({ reasoning_content: "Native reasoning." });
+      yield makeCompletionsChunk({ content: `${prefix}<think>unfinished reasoning` });
+      yield makeCompletionsChunk({}, "stop");
+    }
+    await processCompletionsStream(
+      chunks(),
+      output,
+      model,
+      {
+        push(event) {
+          if (event.type === "text_delta") {
+            text.push(event.delta);
+          }
+        },
+      },
+      { emitReasoning: false },
+    );
+    expect(text.join("")).toBe(prefix);
+    expect(
+      output.content
+        .filter((block) => block.type === "text")
+        .map((block) => block.text)
+        .join(""),
+    ).toBe(prefix);
+  });
+
+  it("does not deliver late text after cancellation of a reasoning-first stream", async () => {
+    const model = makeCompletionsModel();
+    const output = createAssistantOutput(model);
+    const text: string[] = [];
+    const controller = new AbortController();
+    async function* chunks() {
+      yield makeCompletionsChunk({ reasoning_content: "Think." });
+      yield makeCompletionsChunk({ content: "Visible before stop." });
+      expect(text.join("")).toBe("Visible before stop.");
+      controller.abort();
+      yield makeCompletionsChunk({ content: "Late text must not arrive." });
+    }
+    await expect(
+      processCompletionsStream(
+        chunks(),
+        output,
+        model,
+        {
+          push(event) {
+            if (event.type === "text_delta") {
+              text.push(event.delta);
+            }
+          },
+        },
+        { emitReasoning: true, signal: controller.signal },
+      ),
+    ).rejects.toThrow(/abort/i);
+    expect(text.join("")).toBe("Visible before stop.");
+  });
+
+  it.each(["length", "content_filter"] as const)(
+    "keeps unfinished inline reasoning private on %s termination",
+    async (finishReason) => {
+      const model = makeCompletionsModel();
+      const output = createAssistantOutput(model);
+      const text: string[] = [];
+      async function* chunks() {
+        yield makeCompletionsChunk({ content: "Prefix. <think>private unfinished" });
+        yield makeCompletionsChunk({}, finishReason);
+      }
+      await processCompletionsStream(chunks(), output, model, {
+        push(event) {
+          if (event.type === "text_delta") {
+            text.push(event.delta);
+          }
+        },
+      });
+      expect(text.join("")).toBe("Prefix. ");
+      expect(
+        output.content
+          .filter((block) => block.type === "text")
+          .map((block) => block.text)
+          .join(""),
+      ).toBe("Prefix. ");
+    },
+  );
+
+  it("keeps unfinished inline reasoning private at a native tool boundary", async () => {
+    const model = makeCompletionsModel();
+    const output = createAssistantOutput(model);
+    const text: string[] = [];
+    async function* chunks() {
+      yield makeCompletionsChunk({ content: "Prefix. <think>private unfinished" });
+      yield makeCompletionsChunk({
+        tool_calls: [
+          {
+            index: 0,
+            id: "call-1",
+            type: "function",
+            function: { name: "lookup", arguments: '{"query":"safe"}' },
+          },
+        ],
+      });
+      yield makeCompletionsChunk({}, "tool_calls");
+    }
+    await processCompletionsStream(chunks(), output, model, {
+      push(event) {
+        if (event.type === "text_delta") {
+          text.push(event.delta);
+        }
+      },
+    });
+    expect(text.join("")).toBe("Prefix. ");
+    expect(
+      output.content
+        .filter((block) => block.type === "text")
+        .map((block) => block.text)
+        .join(""),
+    ).toBe("Prefix. ");
+    expect(output.content.filter((block) => block.type === "toolCall")).toMatchObject([
+      { id: "call-1", name: "lookup", arguments: { query: "safe" } },
+    ]);
+    expect(output.stopReason).toBe("toolUse");
+  });
+});
